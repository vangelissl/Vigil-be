# === Database ===
DATABASE_URL=postgresql+asyncpg://vigil:vigil_secret@localhost:5432/vigil

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === JWT ===
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === EdDSA ===
EDDSA_PRIVATE_KEY=GENERATE_PRIVATE_KEY_AND_PASTE_IN_PEM_FORMAT
EDDSA_PUBLIC_KEY=GENERATE_PUBLIC_KEY_AND_PASTE_IN_PEM_FORMAT

# === MinIO (S3) ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vigil-media
MINIO_SECURE=false

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_BEAT_SCHEDULER=redis://localhost:6379/2

# === App ===
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
